            <ownedFeatures xsi:type="org.polarsys.capella.core.data.cs:PhysicalPort"
                id="f2554736-2170-4719-a1b4-b919fadc11c1" name="PP 4">
              <ownedExtensions xsi:type="smw:TcItemRevision" id="9f14dd40-5bd4-45e9-bc59-3285ada746f3"
                  tcuid="hetVRRlZ4nxmPD" occTcuid="GYiVRRlZ4nxmPD"/>
