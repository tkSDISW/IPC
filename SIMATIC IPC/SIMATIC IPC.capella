                    tcuid="henVRRlZ4nxmPD" occTcuid="FAlVRRlZ4nxmPD"/>
                <ownedComponentPortAllocations xsi:type="org.polarsys.capella.core.data.fa:ComponentPortAllocation"
                    id="925e6a91-091f-4564-af8a-cf4e0e5778bf" targetElement="#b255d648-6ffe-47ee-993c-b8360c07ef92"
                    sourceElement="#431532a0-65f9-458e-bbbf-32d515edd58b">
                  <ownedExtensions xsi:type="smw:TcItemRevision" id="def3a986-5002-49c3-a76c-aa6b06a7ca77"
                      tcuid="2giVRRlZ4nxmPD" stableTcId="2giVRRlZ4nxmPD"/>
